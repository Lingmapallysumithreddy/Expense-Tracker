pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID     = '648471849551' // Configure with your AWS Account ID
        AWS_DEFAULT_REGION = 'us-east-1'
        ECR_REGISTRY       = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_DEFAULT_REGION}.amazonaws.com"
        
        // ECR Repositories (declared in Terraform outputs)
        BACKEND_REPO       = 'production-backend'
        FRONTEND_REPO      = 'production-frontend'
        
        EKS_CLUSTER_NAME   = 'finflow-eks-cluster'
        
        // Jenkins Credentials IDs
        AWS_CRED_ID        = 'aws-credentials' // Configure inside Jenkins Credentials Management
        IMAGE_TAG          = "${BUILD_NUMBER}"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        keepStepStatuses()
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout Source') {
            steps {
                git branch: 'main', url: 'https://github.com/Lingmapallysumithreddy/Expense-Tracker.git'
            }
        }

        stage('AWS ECR Login') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: "${AWS_CRED_ID}"
                ]]) {
                    sh "aws ecr get-login-password --region ${AWS_DEFAULT_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                echo 'Building backend Docker image...'
                sh "docker build -t ${ECR_REGISTRY}/${BACKEND_REPO}:${IMAGE_TAG} -t ${ECR_REGISTRY}/${BACKEND_REPO}:latest ./backend"
                
                echo 'Building frontend Docker image...'
                // Inject the API load balancer path /api as Vite build argument
                sh "docker build --build-arg VITE_API_URL=/api -t ${ECR_REGISTRY}/${FRONTEND_REPO}:${IMAGE_TAG} -t ${ECR_REGISTRY}/${FRONTEND_REPO}:latest ./frontend"
            }
        }

        stage('Push to ECR') {
            steps {
                echo 'Pushing Backend image to AWS ECR...'
                sh "docker push ${ECR_REGISTRY}/${BACKEND_REPO}:${IMAGE_TAG}"
                sh "docker push ${ECR_REGISTRY}/${BACKEND_REPO}:latest"

                echo 'Pushing Frontend image to AWS ECR...'
                sh "docker push ${ECR_REGISTRY}/${FRONTEND_REPO}:${IMAGE_TAG}"
                sh "docker push ${ECR_REGISTRY}/${FRONTEND_REPO}:latest"
            }
        }

        stage('Deploy to EKS') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: "${AWS_CRED_ID}"
                ]]) {
                    echo 'Updating kubeconfig connection details...'
                    sh "aws eks update-kubeconfig --name ${EKS_CLUSTER_NAME} --region ${AWS_DEFAULT_REGION}"

                    echo 'Applying ConfigMaps, Secrets, and services...'
                    sh "kubectl apply -f kubernetes/namespace.yaml"
                    sh "kubectl apply -f kubernetes/configmap.yaml"
                    sh "kubectl apply -f kubernetes/secrets.yaml"
                    sh "kubectl apply -f kubernetes/ingress.yaml"
                    sh "kubectl apply -f kubernetes/hpa.yaml"

                    echo 'Updating deployments with the new ECR image tags...'
                    sh "kubectl set image deployment/finflow-backend backend=${ECR_REGISTRY}/${BACKEND_REPO}:${IMAGE_TAG} -n finflow"
                    sh "kubectl set image deployment/finflow-frontend frontend=${ECR_REGISTRY}/${FRONTEND_REPO}:${IMAGE_TAG} -n finflow"

                    echo 'Triggering EKS Deployment rolling restart verification...'
                    sh "kubectl rollout status deployment/finflow-backend -n finflow"
                    sh "kubectl rollout status deployment/finflow-frontend -n finflow"
                }
            }
        }
    }

    post {
        success {
            echo 'FinFlow build, ECR upload and EKS rolling deployment succeeded!'
            sh "docker rmi ${ECR_REGISTRY}/${BACKEND_REPO}:${IMAGE_TAG} ${ECR_REGISTRY}/${FRONTEND_REPO}:${IMAGE_TAG} || true"
            sh "docker rmi ${ECR_REGISTRY}/${BACKEND_REPO}:latest ${ECR_REGISTRY}/${FRONTEND_REPO}:latest || true"
        }
        failure {
            echo 'Build or EKS deployment pipeline encountered a failure. Inspect logs.'
        }
    }
}
